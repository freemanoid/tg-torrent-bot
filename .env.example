# tg-torrent-bot configuration
# Copy to .env and fill in the values. Empty values are treated as unset.
#
# Docker: docker-compose.yml reads this file via `env_file: .env` and mounts
# ./data into the container at /data, so the default DB_PATH=/data/bot.db
# lands in ./data/bot.db on the host. Leave DB_PATH unset when using compose.

# --- Required ---

# Telegram bot token from @BotFather.
TELEGRAM_TOKEN=

# Single-user allowlist: every incoming update from any other chat is dropped.
# Get yours by messaging @userinfobot. Group chat IDs are negative.
ALLOWED_CHAT_ID=

# Prowlarr base URL.
#
# On Umbrel, use the service's *container name* on umbrel_main_network, not
# umbrel.local: `.local` is mDNS and does not resolve inside the container, and
# the published host port is fronted by Umbrel's app proxy. (Prowlarr happens to
# let an API-keyed request through that proxy; Transmission does not — see below.)
PROWLARR_URL=http://prowlarr_server_1:9696

# Prowlarr API key: Prowlarr -> Settings -> General -> API Key.
PROWLARR_API_KEY=

# Transmission RPC base URL.
#
# Must be the container name. http://umbrel.local:9091 does NOT work: Umbrel's
# app proxy answers RPC calls with a 302 to the dashboard login on port 2000.
TRANSMISSION_URL=http://transmission_server_1:9091

# --- Optional ---

# Transmission RPC credentials, only if auth is enabled.
TRANSMISSION_USER=
TRANSMISSION_PASS=

# SQLite database location (should point at a mounted volume in Docker).
# Default: /data/bot.db
DB_PATH=

# How often subscriptions are re-checked, as a Go duration (e.g. 20m, 1h).
# Default: 20m
SUB_INTERVAL=
